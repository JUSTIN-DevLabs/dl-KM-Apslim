/* Target SDK: nRF Connect SDK v3.4 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    test_leds {
        compatible = "gpio-leds";
        fdc_debug_led: fdc_debug_led {
            gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
        };
    };
    aliases {
        fdc-heartbeat = &fdc_debug_led;
    };
    zephyr,user {
        pwr-enable-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
    };
};

&pinctrl {
    fdc_i2c_default: fdc_i2c_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
        };
    };
    fdc_i2c_sleep: fdc_i2c_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 25)>;
            low-power-enable;
        };
    };
};

/* SPI1 shares its peripheral instance with I2C1 on nRF52840. */
&spi1 { status = "disabled"; };
&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&fdc_i2c_default>;
    pinctrl-1 = <&fdc_i2c_sleep>;
    pinctrl-names = "default", "sleep";
};

&zephyr_udc0 {
    status = "okay";
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};
