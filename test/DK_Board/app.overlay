
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
};

/* Disable UART0 to release P0.08 and P0.06 */
&uart0 {
    status = "disabled";
};

/* I2C pin configuration */
&pinctrl {
    i2c0_accel_default: i2c0_accel_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 8)>,
                    <NRF_PSEL(TWIM_SDA, 0, 6)>;
        };
    };

    i2c0_accel_sleep: i2c0_accel_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SCL, 0, 8)>,
                    <NRF_PSEL(TWIM_SDA, 0, 6)>;
            low-power-enable;
        };
    };
};

/* LIS2DH I2C interface */
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";

    clock-frequency = <I2C_BITRATE_STANDARD>;

    pinctrl-0 = <&i2c0_accel_default>;
    pinctrl-1 = <&i2c0_accel_sleep>;
    pinctrl-names = "default", "sleep";
};

/* USB CDC ACM virtual COM port */
&zephyr_udc0 {
    status = "okay";

    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
        status = "okay";
    };
};
